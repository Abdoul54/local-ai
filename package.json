{
  "name": "local-ai",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "local-ai": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/local-ai",
    "build:linux-x64": "bun build src/index.ts --compile --outfile dist/local-ai-linux-x64 --target bun-linux-x64",
    "build:linux-arm64": "bun build src/index.ts --compile --outfile dist/local-ai-linux-arm64 --target bun-linux-arm64",
    "install:global": "bun run build && sudo cp dist/local-ai /usr/local/bin/local-ai && echo 'Installed: local-ai is now available system-wide'",
    "uninstall:global": "sudo rm -f /usr/local/bin/local-ai && echo 'Uninstalled'"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ai": "^6.0.154",
"ollama-ai-provider-v2": "^3.5.0"
  }
}
