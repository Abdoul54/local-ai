# Ollama server URL (default: http://localhost:11434/api)
OLLAMA_HOST=http://localhost:11434/api

# Model to use — must be pulled locally via: ollama pull <model>
OLLAMA_MODEL=gemma4:latest

# Where to store the chat database (default: ~/.local/share/gemma-cli/chat.db)
# DB_PATH=/custom/path/chat.db
